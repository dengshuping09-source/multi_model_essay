APP_NAME=多模型协同作文智能评测系统 API
APP_ENV=development
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+asyncpg://essay_app:change_me@localhost:5432/essay_evaluation
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=10
MAX_UPLOAD_FILES=10
MAX_IMAGE_PIXELS=40000000
MAX_ESSAY_TEXT_LENGTH=50000
OCR_DEVICE=cpu
OCR_DETECTION_MODEL=PP-OCRv5_mobile_det
OCR_RECOGNITION_MODEL=PP-OCRv5_mobile_rec
OCR_ENABLE_MKLDNN=false
OCR_CPU_THREADS=4
OCR_WORKER_ENABLED=false
OCR_WORKER_POLL_SECONDS=1
OCR_WORKER_JOB_TIMEOUT_SECONDS=180
OCR_WORKER_STALE_SECONDS=300
OCR_WORKER_MAX_JOBS_PER_PROCESS=20
OCR_LOW_CONFIDENCE_THRESHOLD=0.65
OCR_DEFAULT_ENGINE=baidu
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_OUTPUT_TOKENS=3000
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-turbo
DOUBAO_API_KEY=
DOUBAO_BASE_URL=
DOUBAO_MODEL=doubao-pro
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-0-lite-260215
ARK_QUICK_MODEL=doubao-seed-2-0-mini-260428
ARK_QUICK_MAX_OUTPUT_TOKENS=1200
ARK_DEEP_MODEL=doubao-seed-2-0-lite-260215
MODEL_REVIEW_TIMEOUT_SECONDS=45
MODEL_REVIEW_QUORUM_GRACE_SECONDS=12
MODEL_REVIEW_MAX_RETRIES=0
MODEL_CALIBRATION_MIN_SAMPLES=8
SESSION_TTL_HOURS=168
BAIDU_OCR_APP_ID=replace_with_your_baidu_ocr_app_id
BAIDU_OCR_API_KEY=replace_with_your_baidu_ocr_api_key
BAIDU_OCR_SECRET_KEY=replace_with_your_baidu_ocr_secret_key
BAIDU_OCR_TOKEN_URL=https://aip.baidubce.com/oauth/2.0/token
BAIDU_HANDWRITING_URL=https://aip.baidubce.com/rest/2.0/ocr/v1/handwriting
BAIDU_OCR_TIMEOUT_SECONDS=30
