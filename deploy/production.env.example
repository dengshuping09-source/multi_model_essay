# Compose exposure. Keep the app on loopback when a host reverse proxy is used.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=18080

# Application
APP_NAME=文衡作文评测 API
APP_ENV=production
API_PREFIX=/api
CORS_ORIGINS=https://wenheng.example.com
DATABASE_URL=postgresql+asyncpg://wenheng_user:URL_ENCODED_PASSWORD@database-host:5432/wenheng
UPLOAD_DIR=/app/storage/uploads
MAX_UPLOAD_SIZE_MB=10
MAX_UPLOAD_FILES=10
MAX_IMAGE_PIXELS=40000000
MAX_ESSAY_TEXT_LENGTH=50000
SESSION_TTL_HOURS=168

# Local OCR
OCR_DEVICE=cpu
OCR_DETECTION_MODEL=PP-OCRv5_mobile_det
OCR_RECOGNITION_MODEL=PP-OCRv5_mobile_rec
OCR_ENABLE_MKLDNN=false
OCR_CPU_THREADS=1
OCR_WORKER_ENABLED=true
OCR_WORKER_POLL_SECONDS=1
OCR_WORKER_JOB_TIMEOUT_SECONDS=180
OCR_WORKER_STALE_SECONDS=300
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
OCR_LOW_CONFIDENCE_THRESHOLD=0.65
PADDLE_PDX_CACHE_HOME=/app/.cache/paddlex

# Independent model reviews
DEEPSEEK_API_KEY=replace_with_production_secret
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_OUTPUT_TOKENS=3000
QWEN_API_KEY=replace_with_production_secret
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-turbo
ARK_API_KEY=replace_with_production_secret
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-0-lite-260215
ARK_QUICK_MODEL=doubao-seed-2-0-mini-260428
ARK_QUICK_MAX_OUTPUT_TOKENS=1200
ARK_DEEP_MODEL=doubao-seed-2-0-lite-260215
MODEL_REVIEW_TIMEOUT_SECONDS=45
MODEL_REVIEW_QUORUM_GRACE_SECONDS=12
MODEL_REVIEW_MAX_RETRIES=0
MODEL_CALIBRATION_MIN_SAMPLES=8

# Optional Baidu OCR fallback. Leave both values empty when unused.
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
BAIDU_OCR_TOKEN_URL=https://aip.baidubce.com/oauth/2.0/token
BAIDU_HANDWRITING_URL=https://aip.baidubce.com/rest/2.0/ocr/v1/handwriting
BAIDU_OCR_TIMEOUT_SECONDS=30

# deploy/deploy.sh refuses to run migrations until a database backup or
# provider snapshot has been confirmed explicitly.
DATABASE_MIGRATION_BACKUP_CONFIRMED=no
